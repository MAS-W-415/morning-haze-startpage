{
  "manifest_version": 3,
  "name": "晨雾起始页",
  "short_name": "晨雾",
  "version": "1.0.1",
  "description": "晨雾浅色、大时钟与安静搜索，自动显示收藏夹栏的 Edge 新标签页。",
  "homepage_url": "https://mas-w-415.github.io/morning-haze-startpage/",
  "chrome_url_overrides": {
    "newtab": "focus.html"
  },
  "permissions": [
    "bookmarks",
    "favicon"
  ],
  "icons": {
    "16": "assets/icons/icon-16.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  }
}
